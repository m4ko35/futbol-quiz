// Futbol Quiz — HESAP ve LİDER TABLOSU veri modeli (PROJECT.md §11).
//
// BU ŞEMA FUTBOL VERİSİNDEN AYRIDIR ve ayrılık kasıtlıdır (§11.3):
//
//   prisma/schema.prisma          → pakete gömülü, SALT OKUNUR futbol verisi
//   prisma/accounts.schema.prisma → Turso'da duran, YAZILABİLİR hesap verisi
//
// Tek şemada birleştirilseydi futbol sorguları da ağ üzerinden gitmek zorunda
// kalırdı ve §3.1'in bütün kazanımları (ağ turu yok, veriyle birlikte
// sürümlenir, `db:verify` geçmeden dağıtılmaz) kaybolurdu.
//
// Üretim komutu:  npm run db:generate:accounts
//
// DERLEMEYE BAĞLI (16 Ağustos 2026). `vercel-build` bu istemciyi de üretiyor.
// Bir süre üretmiyordu ve üretim dağıtımı "Module not found" ile düştü — sebebi
// `/src/generated/`'in .gitignore'da olması: klasör geliştirici diskinde durduğu
// için `npm run verify` geçiyor, Vercel ise temiz bir çıkış alıyordu (§11.3).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-accounts"
}

// Turso libSQL konuşur ve SQLite ile söz dizimi uyumludur; sağlayıcı bu yüzden
// "sqlite" kalır (§11.3 — ikinci bir SQL lehçesi bakımı doğmasın diye).
//
// AŞAĞIDAKİ ADRES KULLANILMAZ ve bu bir ihmal değil, Prisma'nın dayattığı bir
// yer tutucudur: "sqlite" sağlayıcısının doğrulayıcısı `file:` ile başlayan bir
// URL görmek ister, oysa gerçek adres `libsql://` ile başlar.
//
// GERÇEK BAĞLANTIYI SÜRÜCÜ BAĞDAŞTIRICISI KURAR — hem çalışma zamanında hem
// göçlerde (prisma/accounts.config.ts). Buradaki dosya yolu hiçbir zaman
// açılmaz; açılsaydı göçler Turso yerine yerel bir dosyaya işlerdi ve bu
// SESSİZ bir hata olurdu — bir kez oldu, §11.3'te yazılı. Göçten sonra
// tabloların gerçekten Turso'da oluştuğu bu yüzden ayrıca sayılıyor.
//
// PRISMA BU SATIRI SİLMEYİ ÖNERİYOR ama silinemiyor: göç komutu "bu değerler
// KULLANILMAYACAK, kaldırmanızı öneririz" diye uyarıyor, kaldırınca da
// doğrulayıcı "url eksik" diyerek durduruyor. İkisi çelişiyor; yer tutucu
// bu çelişkinin sonucudur, tercih değil.
datasource db {
  provider = "sqlite"
  url      = "file:./KULLANILMIYOR.db"
}

/// Hesap — §11.3, BR-46.
///
/// E-POSTA SAKLANMAZ ve bu bir eksiklik değil karardır: Google bize e-posta ve
/// ad döner, ikisini de tutmak zorunda değiliz. Hesap kurtarma Google'ın
/// işidir, yani e-postanın bizde durmasının işlevsel bir karşılığı yok —
/// yalnızca KVKK sorumluluğu var.
model User {
  id String @id

  /// Google OAuth `sub` değerinin ÖZETİ — ham değer saklanmaz.
  ///
  /// Özet, veritabanı sızarsa "bu Google hesabı burada oynuyor mu" sorusunu
  /// yanıtlanamaz kılmak içindir. Yalın özet bunu TAM KAPATMAZDI: elinde bir
  /// `sub` olan biri özeti hesaplayıp karşılaştırabilirdi. Bu yüzden yalın
  /// özet değil, `AUTH_SECRET` ile HMAC kullanılıyor (§11.10) — anahtar
  /// sunucuda olduğu için karşılaştırma dışarıdan yapılamaz.
  subjectHash String @unique

  /// Kullanıcının SEÇTİĞİ ad (BR-46). Google'dan gelen gerçek ad değildir.
  displayName String

  /// Tekillik ölçütü — `toSearchKey` normalleştirmesi (BR-46).
  ///
  /// Tekillik ham ad üzerinden zorlansaydı "Mehmet" varken "mehmet", "MEHMET"
  /// ve çift boşluklu "Mehmet  " hepsi ayrı satır olurdu; tabloda gözle ayırt
  /// edilemezler.
  displayNameKey String @unique

  createdAt DateTime @default(now())

  rounds DailyRound[]

  /// BR-53 — yapılan ve alınan bildirimler. İKİ İLİŞKİ AYNI MODELE gittiği
  /// için adlandırılmak zorunda; adsız bırakılsalardı Prisma hangi alanın
  /// hangi tarafı olduğunu çözemezdi.
  reportsMade     NameReport[] @relation("bildiren")
  reportsReceived NameReport[] @relation("bildirilen")

  /// §12 — kurduğu odalar ve oturduğu koltuklar. İkisi AYRI: kurduğu oda
  /// onun sorumluluğundadır (yeni oda kurunca eskisi silinir), katıldığı oda
  /// başkasınındır ve onu silmek arkadaşının odasını elinden almak olurdu.
  hostedRooms Room[]
  roomSeats   RoomPlayer[]

  @@map("users")
}

/// Bir kullanıcının bir bulmaca gününe ait turu — BR-43, BR-44, BR-45.
model DailyRound {
  id String @id

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Gün tohumu (`dailySeed`), örn. 20260815 — BR-49'un 06:00 sınırıyla.
  ///
  /// TARİH DEĞİL SAYI: tohum zaten uygulamanın gün ölçütü ve tarih tipi
  /// saklamak ikinci bir gerçek kaynağı yaratırdı. Aralık sorguları sayı
  /// karşılaştırmasıyla çalışır — ay sonlarında 20260832..20260899 gibi
  /// boşluklar oluşur ama o değerlere karşılık gelen satır hiç üretilmez,
  /// yani `>= başlangıç AND <= bitiş` doğru sonucu verir.
  puzzleDay Int

  /// BR-44 — sunucuda biriken toplam, 0–600.
  ///
  /// TÜRETİLMİŞ ALAN: cevapların puan toplamıdır. Saklanmasının sebebi lider
  /// tablosu sorgusunun tek bir dizin taramasına inmesi. Bedeli, cevap
  /// eklerken AYNI İŞLEMDE güncellenmek zorunda olması — ayrışırsa tablo
  /// sessizce yanlış sıralar.
  points Int @default(0)

  /// BR-45 — tamamlanmamış tur lider tablosuna GİRMEZ.
  ///
  /// `null` = yarım. Yarım turu 0 puanla listeye koymak yanlış olurdu:
  /// kullanıcı kötü oynadığı için değil, bitirmediği için listede yok.
  completedAt DateTime?

  createdAt DateTime @default(now())

  answers RoundAnswer[]

  /// BR-43 — bir kullanıcı, bir gün, TEK tur.
  @@unique([userId, puzzleDay])
  /// Lider tablosunun günlük/haftalık sorgusu (BR-50) bu dizinden okur.
  @@index([puzzleDay, points])
  @@map("daily_rounds")
}

/// Tek bir istatistiğe verilmiş cevap — BR-43, BR-17.
model RoundAnswer {
  id String @id

  roundId String
  round   DailyRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  /// `StatKey` — sözleşmenin parçası (§6.5).
  statKey String

  /// Seçilen oyuncunun futbol veritabanındaki kimliği.
  ///
  /// YABANCI ANAHTAR YOK ve olamaz: oyuncu tablosu BAŞKA bir veritabanında
  /// (pakete gömülü SQLite). Bunun sonucu kabul edilmiştir — veri kümesi
  /// yenilendiğinde bir kimlik kaybolursa buradaki kayıt öksüz kalır. Puanı
  /// etkilemez, çünkü değer ve puan cevap anında yazılır.
  playerId String

  /// Seçilen oyuncunun o istatistikteki değeri (sunucu okumuştur).
  value Int

  /// BR-18, 0–100 — sunucu hesaplar (BR-20).
  score Int

  createdAt DateTime @default(now())

  /// BR-43 — istatistik başına TEK deneme.
  ///
  /// KISIT UYGULAMA MANTIĞININ TEKRARI DEĞİL, GARANTİSİDİR. `judgeSubmission`
  /// önce okuyup sonra yazar; aynı anda gelen iki istek ikisi de "bu istatistik
  /// boş" görüp ikisi de yazabilir. O yarışı yalnızca veritabanı kısıtı
  /// durdurur.
  @@unique([roundId, statKey])
  /// BR-17 — bir oyuncu bir turda yalnızca bir istatistikte kullanılır.
  @@unique([roundId, playerId])
  @@map("round_answers")
}

/// Bir görünen ad hakkında bildirim — BR-53, §11.12.
///
/// BİLDİRİM OTOMATİK İŞLEM TETİKLEMEZ. Eşik koyup "üç bildirim alan ad
/// gizlenir" demek, anlaşmış üç kişinin meşru bir adı sildirmesine izin
/// verirdi: kötüye kullanımı önleyen mekanizma kendisi bir kötüye kullanım
/// aracına dönüşürdü. Bu tablo yalnızca DİKKAT ÇEKER; karar insana aittir.
model NameReport {
  id String @id

  /// Bildiren kullanıcı — giriş şart.
  ///
  /// Anonim bildirim sınırsız ve hesapsızdır; ayrıca aşağıdaki "bir kez"
  /// kısıtının dayanacağı bir kimlik kalmazdı.
  reporterId String
  reporter   User   @relation("bildiren", fields: [reporterId], references: [id], onDelete: Cascade)

  /// Adı bildirilen kullanıcı.
  reportedId String
  reported   User   @relation("bildirilen", fields: [reportedId], references: [id], onDelete: Cascade)

  /// Sabit sebep: `hakaret` | `taklit` | `reklam`.
  ///
  /// Üçü §11.2'nin T5 tehdidinden geliyor, uydurulmadı.
  ///
  /// SERBEST METİN ALANI YOK ve bu kararın kendisidir (§11.12): serbest metin,
  /// adına küfredemeyen kişiye bildirim formunda küfretme imkânı verirdi —
  /// yani kötüye kullanımı önleyecek araç, ikinci bir kötüye kullanım kanalı
  /// olurdu. Alan hiç olmayınca o sınıfın tamamı kapanıyor.
  reason String

  createdAt DateTime @default(now())

  /// BR-53 — bir kullanıcı bir hedefi BİR KEZ bildirir.
  ///
  /// KISIT UYGULAMA MANTIĞININ TEKRARI DEĞİL, GARANTİSİDİR (BR-17 ve BR-46 ile
  /// aynı gerekçe): "önce bak sonra yaz" eşzamanlı iki istekte iki satır
  /// üretir. Bu satır ayrıca sayımı anlamlı kılıyor — bildirim sayısı gerçek
  /// kişi sayısıdır, tıklama sayısı değil.
  @@unique([reporterId, reportedId])
  /// İşletmecinin listesi hedefe göre gruplanır.
  @@index([reportedId])
  @@map("name_reports")
}

/// Oda — PROJECT.md §12, BR-54/BR-55/BR-56/BR-57/BR-60.
///
/// DURUM SÜTUNU YOK ve bu bilinçli (§12.3). `bekliyor`/`oynaniyor`/`bitti`/
/// `suresi-doldu` buradaki OLGULARDAN türetilir (`domain/services/room.ts`).
/// Sütun tutulsaydı olgularla ayrışabilirdi ve ayrıştığında hangisinin doğru
/// olduğunu kimse bilemezdi.
model Room {
  id String @id

  /// BR-55 — 25 işaretlik alfabeden altı karakter.
  ///
  /// TEKİLLİK KISITI GARANTİDİR, süsleme değil: kod rastgele üretiliyor ve
  /// "önce bak, boşsa yaz" iki eşzamanlı kurulumda aynı kodu iki odaya
  /// verebilir. O yarışı yalnızca veritabanı durdurur.
  code String @unique

  /// Odayı kuran. TÜRETİLEBİLİR DEĞİL: "ilk katılan" diye hesaplansaydı,
  /// ileride yeniden katılmaya izin veren bir değişiklik sahipliği sessizce
  /// başkasına geçirebilirdi. Sahiplik bir OLGUDUR ve yazılı durur.
  hostId String
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  /// BR-56 — hedefi SUNUCU seçti; istemci hedef gönderemez.
  ///
  /// YABANCI ANAHTAR YOK ve olamaz: oyuncu tablosu BAŞKA bir veritabanında
  /// (pakete gömülü SQLite). `RoundAnswer.playerId` ile aynı gerekçe.
  targetPlayerId String

  /// BR-57 — ikinci oyuncunun katıldığı an.
  ///
  /// `null` olduğu sürece hedef HİÇ KİMSEYE gönderilmez, kurucuya da. Erken
  /// verilseydi kurucu, arkadaşı kodu girene kadar hazırlanabilirdi — BR-56
  /// tam olarak o avantajı kapatıyor.
  startedAt DateTime?

  createdAt DateTime @default(now())

  players RoomPlayer[]

  /// BR-60 — sönmüş odaların temizliği bu sütunlardan okur. Tablo yapısı
  /// gereği küçük kalıyor (oda en fazla bir saat yaşar), bu yüzden tek bir
  /// dizin yeterli.
  @@index([createdAt])
  @@map("rooms")
}

/// Odadaki bir koltuk — BR-54.
///
/// `points` SAKLANMIYOR, `DailyRound`'un aksine. Orada saklanmasının sebebi
/// lider tablosu sorgusunun tek bir dizin taramasına inmesiydi; oda sonucu
/// hiçbir yerde sıralanmıyor (BR-60), yani türetilmiş bir sütunu bakma
/// külfetine sokacak bir kazanç yok. Toplam cevaplardan hesaplanıyor.
///
/// `completedAt` de yok: bitmişlik altı cevabın varlığından okunuyor ve BR-62
/// zaten süreye bakmıyor — eşit toplam beraberliktir, ilk bitiren kazanmaz.
model RoomPlayer {
  id String @id

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// BR-54'ün SAYI kısıtı — 0 kurucu, 1 katılan. Başka değer yazılmaz.
  ///
  /// NEDEN AYRI BİR SÜTUN: `@@unique([roomId, userId])` "aynı kişi iki kez
  /// oturamaz" der ama KAÇ KİŞİ oturduğunu söylemez. Eşzamanlı iki katılma
  /// isteği (kodu iki arkadaşına birden söyleyen bir kurucu) ikisi de "odada
  /// bir kişi var" görüp ikisi de yazabilirdi ve oda üç kişilik olurdu.
  /// Koltuk numarası bu yarışı veritabanına taşıyor: ikinci koltuğu yalnızca
  /// biri alabilir.
  ///
  /// `hostId` ile bu sütunun 0'ıncı koltuğu AYNI kişiyi göstermek zorunda.
  /// İkisi tek işlemde yazılıyor ve hiçbir zaman güncellenmiyor; `hostId`
  /// yine de duruyor çünkü hesap silindiğinde odayı düşüren şey o (BR-48).
  seat Int

  createdAt DateTime @default(now())

  answers RoomAnswer[]

  /// BR-54 — bir kullanıcı bir odada TEK koltuk tutar.
  @@unique([roomId, userId])
  /// BR-54 — bir odada EN FAZLA İKİ koltuk vardır.
  @@unique([roomId, seat])
  @@map("room_players")
}

/// Oda turundaki tek bir cevap — BR-58, BR-17.
///
/// Şekli `RoundAnswer` ile birebir aynıdır ve bu kasıtlı: oda oyunu yeniden
/// tanımlamıyor, §11'in turunu başka bir bağlamda oynatıyor. Puanlama kuralı
/// da tek yerde kalıyor (`domain/services/daily-round.ts`).
model RoomAnswer {
  id String @id

  roomPlayerId String
  player       RoomPlayer @relation(fields: [roomPlayerId], references: [id], onDelete: Cascade)

  statKey String

  /// Seçilen oyuncunun futbol veritabanındaki kimliği; yabancı anahtar yok.
  playerId String

  value Int
  score Int

  createdAt DateTime @default(now())

  /// BR-58 — istatistik başına TEK deneme.
  ///
  /// KISIT UYGULAMA MANTIĞININ TEKRARI DEĞİL, GARANTİSİDİR (BR-43 ile aynı
  /// gerekçe): karar önce okuyup sonra yazar; aynı anda gelen iki istek ikisi
  /// de "bu istatistik boş" görüp ikisi de yazabilir. O yarışı yalnızca
  /// veritabanı durdurur.
  @@unique([roomPlayerId, statKey])
  /// BR-17'nin oda karşılığı — bir oyuncu bir turda tek istatistikte kullanılır.
  @@unique([roomPlayerId, playerId])
  @@map("room_answers")
}
