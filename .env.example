# ─────────────────────────────────────────────────────────────────────────
# Bu dosya bir SABLONDUR ve versiyon kontrolune girer.
# Gercek degerleri `.env` dosyasina yazin — o dosya .gitignore'dadir (§7.6).
# Buraya asla gercek bir sir yazmayin.
# ─────────────────────────────────────────────────────────────────────────

# Veritabani baglanti dizesi. SQLite icin dosya yolu (§3).
# DIKKAT: Prisma bu goreli yolu prisma/schema.prisma dosyasinin BULUNDUGU
# klasore gore cozer, proje kokune gore degil. Yani "./dev.db" degeri
# prisma/dev.db dosyasina isaret eder.
DATABASE_URL="file:./dev.db"

# ─── ETL (yalnizca `npm run etl` icin; web sureci bunlari kullanmaz) ─────

# Wikidata, kendisine kimlik bildirmeyen istemcileri engeller.
# Gercek bir iletisim adresi yazin — aksi halde istekleriniz reddedilir.
ETL_USER_AGENT="futbol-quiz/0.1.0 (https://github.com/KULLANICI/futbol-quiz; eposta@ornek.com)"

# Wikidata SPARQL ucu. Degistirmeniz gerekmez.
WIKIDATA_SPARQL_ENDPOINT="https://query.wikidata.org/sparql"

# Wikidata'ya saniyede birden fazla istek atmayin (§7.4).
ETL_REQUESTS_PER_SECOND="1"

# ─── Istek hizi sinirlama (§7.5) ────────────────────────────────────────

RATE_LIMIT_REQUESTS_PER_MINUTE="60"
RATE_LIMIT_BURST="10"
