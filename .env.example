# ─────────────────────────────────────────────────────────────────────────
# Bu dosya bir SABLONDUR ve versiyon kontrolune girer.
# Gercek degerleri `.env` dosyasina yazin — o dosya .gitignore'dadir (§7.6).
# Buraya asla gercek bir sir yazmayin.
# ─────────────────────────────────────────────────────────────────────────

# Veritabani baglanti dizesi. SQLite icin dosya yolu (§3).
# DIKKAT: Prisma bu goreli yolu prisma/schema.prisma dosyasinin BULUNDUGU
# klasore gore cozer, proje kokune gore degil. Yani "./dev.db" degeri
# prisma/dev.db dosyasina isaret eder.
DATABASE_URL="file:./dev.db"

# ─── ETL (yalnizca `npm run etl` icin; web sureci bunlari kullanmaz) ─────

# Wikidata, kendisine kimlik bildirmeyen istemcileri engeller.
# Gercek bir iletisim adresi yazin — aksi halde istekleriniz reddedilir.
ETL_USER_AGENT="futbol-quiz/0.1.0 (https://github.com/KULLANICI/futbol-quiz; eposta@ornek.com)"

# Wikidata SPARQL ucu. Degistirmeniz gerekmez.
WIKIDATA_SPARQL_ENDPOINT="https://query.wikidata.org/sparql"

# Wikidata'ya saniyede birden fazla istek atmayin (§7.4).
ETL_REQUESTS_PER_SECOND="1"

# ─── Istek hizi sinirlama (§7.5) ────────────────────────────────────────

RATE_LIMIT_REQUESTS_PER_MINUTE="60"
RATE_LIMIT_BURST="10"

# Onunuzde kac GUVENILEN ters vekil var?
#
#   0 = sunucu dogrudan internete acik. X-Forwarded-For TAMAMEN yok sayilir ve
#       hiz siniri sunucu geneline duser (istemci basina degil).
#   1 = tek bir kenar vekil (nginx, Cloudflare vb.) — varsayilan.
#   2 = CDN + kendi vekiliniz gibi iki katman.
#
# Bu degeri GERCEKTEN oldugundan buyuk vermeyin: istemcinin uydurdugu adresi
# gercek sanmaya ve hiz sinirinin baypas edilmesine yol acar (§7.5).
#
# DIKKAT: dogru deger dagitim ortamina baglidir ve ILK DAGITIMDA OLCULMELIDIR.
# Yontem: bilinen bir adresten istek atip log'daki istemci anahtarinin gercek
# adrese esit olup olmadigina bakin. Yanlis deger, hiz sinirini ya asiri
# genis (baypas edilebilir) ya da asiri dar (tum kullanicilar tek kova) yapar.
TRUSTED_PROXY_HOPS="1"

# ─── Site kimligi ve indeksleme (§7.11) ─────────────────────────────────

# Sitenin herkese acik kok adresi. Paylasim meta verisi (og:url vb.) bunun
# uzerine kurulur; goreli adresleri hicbir sohbet uygulamasi cozemez.
# Yerelde varsayilan yeterli, dagitimda gercek alan adini verin.
SITE_URL="http://localhost:3000"

# Site arama motorlarina acik mi? "true" veya "false" — baska deger kabul
# edilmez ve uygulama baslamaz.
#
# TEK ANAHTAR: hem robots.txt hem sayfadaki noindex etiketi bunu okur.
# Varsayilan "false" — unutulan bir yapilandirma siteyi sessizce arama
# sonuclarina sokmasin diye. Yayina hazir oldugunuzda "true" yapin.
SITE_INDEXABLE="false"

# ─── Gizlilik bildirimi (§7.18) ─────────────────────────────────────────

# KVKK basvuru adresi — /gizlilik sayfasinda YAYIMLANIR.
#
# SITE_INDEXABLE="true" ile KENETLIDIR: adres verilmeden siteyi arama
# sonuclarina acmaya calisirsaniz uygulama BASLAMAZ. Sebep, adressiz bir
# aydinlatma metninin eksik sayilmasi (KVKK m.10).
#
# Yerelde gerekmez, cunku SITE_INDEXABLE varsayilan olarak "false".
# Kisisel adresinizi yayimlamak istemiyorsaniz siteye ozel bir adres acin.
# CONTACT_EMAIL="iletisim@ornek.com"

# ─── Dagitim (yalnizca derleme adiminda; yerelde GEREKMEZ) ──────────────

# Yayimlanmis veri kumesinin adresi. `npm run vercel-build` bunu indirir;
# tanimli degilse derleme DURUR (§3.1). GitHub Actions'in olusturdugu surum
# varligina isaret eder:
#   https://github.com/KULLANICI/futbol-quiz/releases/download/dataset-latest/dev.db
# DATASET_URL=""

# Yalnizca OZEL depolarda gerekir; herkese acik depoda bos birakilir.
# DATASET_TOKEN=""
